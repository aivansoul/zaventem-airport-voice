    },
    "Vérifier la source autorisée": {
      "main": [[{"node": "Créer l'observation", "type": "main", "index": 0}]]
    },
    "Créer l'observation": {
      "main": [[{"node": "Demander une revue humaine", "type": "main", "index": 0}]]
    },
    "Demander une revue humaine": {
      "main": [[{"node": "Une source à la fois", "type": "main", "index": 0}]]
    }
  },
